# luci-app-mesh — 让 nginx + uwsgi 型固件(如 Kwrt)也能执行 mesh-sync 这个 CGI。
#
# 背景：/cgi-bin/mesh-sync 是 uhttpd 的 CGI 约定。标准 OpenWrt 用 uhttpd，
# 会把 /cgi-bin/ 下的可执行脚本直接当 CGI 跑，无需本文件；因此标准固件上
# 若没有 nginx，此文件不会被任何东西读取，纯属无害冗余。
#
# 但在用 nginx + uwsgi (luci-nginx) 的固件上，nginx 默认只把 /cgi-bin/luci
# 交给 uwsgi，其余 /cgi-bin/* 会被当静态文件原样返回 —— 子节点拿到的将是
# 脚本源码而不是 JSON，表现为“同步失败: 同步令牌与主节点不一致”。
#
# 本文件复用 LuCI 自己那套 uwsgi CGI 通道(cgi-mode + uwsgi_modifier1 9)，
# 与 /etc/nginx/conf.d/luci.locations 原理一致。
# 生效前提：/etc/config/nginx 中存在 `list include 'conf.d/*.locations'`。
location /cgi-bin/mesh-sync {
	include uwsgi_params;
	uwsgi_read_timeout 30s;
	uwsgi_param SERVER_ADDR $server_addr;
	uwsgi_modifier1 9;
	uwsgi_pass unix:////var/run/luci-webui.socket;
}
